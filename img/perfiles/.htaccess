# Desactivar ejecucion de scripts en carpeta de subida de perfiles
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|inc|pl|py|cgi)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
